# Scriffle Theme Configuration
# Nord Palette (Arctic Frost)

[metadata]
name = "Nord Frost"
author = "Arctic IceStudio"
version = "1.0.0"
mode_base = "dark"

[canvas]
background = #242933
grid_dot = #3B4252
selection_box = #88C0D0
