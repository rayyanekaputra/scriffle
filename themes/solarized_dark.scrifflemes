# Scriffle Theme Configuration
# Solarized Dark (Precision Navy & Cyan)

[metadata]
name = "Solarized Dark"
author = "Ethan Schoonover"
version = "1.0.0"
mode_base = "dark"

[canvas]
background = #00212B
grid_dot = #073642
